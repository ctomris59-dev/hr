# FutureHR backend production template
# Store real values only in the deployment platform's encrypted secrets.

ENVIRONMENT=production
APP_ENV=production
DEBUG=false
DATA_MODE=database
SAAS_AUTH_ENABLED=true
ALLOW_LEGACY_API_IN_SAAS=false

DATABASE_URL=postgresql://futurehr:CHANGE_ME@db.example.internal:5432/futurehr
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

ALLOWED_HOSTS=["api.example.com"]
CORS_ORIGINS=["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=true

ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
LOG_LEVEL=INFO
LOG_FORMAT=json
