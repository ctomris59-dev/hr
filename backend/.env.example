# FutureHR backend environment example
#
# The current prototype remains in demo mode by default.  Do not enable secure
# SaaS auth until PostgreSQL is provisioned and migrations have been applied.

APP_NAME=FutureHR API
APP_ENV=development
ENVIRONMENT=development
DEBUG=false

# Demo keeps current JSON/browser prototype behavior.
DATA_MODE=demo

# PostgreSQL (required before DATA_MODE=database / SAAS_AUTH_ENABLED=true)
# Example hosted URL:
# DATABASE_URL=postgresql://futurehr:password@host:5432/futurehr
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Secure auth. Generate a long random value; never commit the real secret.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7
SAAS_AUTH_ENABLED=false

# Restrict these to the real frontend domains in production.
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=INFO
LOG_FORMAT=json
