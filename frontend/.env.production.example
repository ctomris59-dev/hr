# FutureHR frontend / Vercel production template
# Never commit real API keys. Configure these as encrypted environment variables.

FUTUREHR_SAAS_MODE=true
NEXT_PUBLIC_DATA_MODE=saas
BACKEND_URL=https://api.example.com

# Primary AI provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary AI provider for provider-level failover
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
